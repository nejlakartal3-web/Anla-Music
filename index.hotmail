<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Anla-Music</title>
  <link rel="stylesheet" href="style.css">
</head>

<body>

  <h1>🎵 Anla-Music</h1>
  <p>Yeni nesil müzik deneyimi</p>

  <div class="music-card">
    <h2>Yeni Şarkı</h2>
    <p>Anla-Music Özel</p>

    <audio controls>
      <source src="sarki.mp3" type="audio/mpeg">
    </audio>

    <button>İndir</button>
  </div>


  <div class="music-card">
    <h2>Kalbimde İz</h2>
    <p>Anla-Music</p>

    <audio controls>
      <source src="sarki2.mp3" type="audio/mpeg">
    </audio>

    <button>İndir</button>
  </div>


  <div class="about">
    <h2>Hakkımızda</h2>
    <p>
      Anla-Music, müziği ve yapay zekayı bir araya getiren
      yeni nesil bir müzik platformudur.
    </p>
  </div>

</body>
</html>